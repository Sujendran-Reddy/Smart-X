@using SmartX.Shared.Models

<section class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Registered sensors (@Sensors.Length)</h2>
            <button type="button"
                    class="btn btn-outline-primary"
                    disabled="@(IsLoading || IsBusy)"
                    @onclick="RefreshAsync">
                @(IsLoading ? "Loading..." : "Refresh sensors")
            </button>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-8">
                <label for="sensorSearch" class="form-label">
                    Search devices or locations
                </label>
                <input id="sensorSearch"
                       type="search"
                       class="form-control"
                       placeholder="Enter a device identifier or location"
                       @bind="searchText"
                       @bind:event="oninput"
                       @bind:after="FilterChanged" />
            </div>

            <div class="col-12 col-md-4">
                <label for="sensorCategoryFilter" class="form-label">
                    Category
                </label>
                <select id="sensorCategoryFilter"
                        class="form-select"
                        @bind="selectedCategory"
                        @bind:after="FilterChanged">
                    <option value="">All categories</option>
                    @foreach (var category in Enum.GetValues<SensorCategory>())
                    {
                        <option value="@category">
                            @CategoryLabel(category)
                        </option>
                    }
                </select>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(LoadError))
        {
            <div class="alert alert-warning" role="alert">
                @LoadError
            </div>
        }

        @if (IsLoading)
        {
            <p role="status">Loading registered sensors...</p>
        }
        else if (Sensors.Length == 0 && string.IsNullOrWhiteSpace(LoadError))
        {
            <p class="text-secondary mb-0">
                No sensors registered yet. Add your first device above.
            </p>
        }
        else if (Sensors.Length > 0 && filteredSensors.Length == 0)
        {
            <div class="alert alert-info">
                No sensors match your search and category.
                <button type="button"
                        class="btn btn-sm btn-outline-primary ms-2"
                        @onclick="ClearFilters">
                    Clear filters
                </button>
            </div>
        }

        @if (filteredSensors.Length > 0)
        {
            <p class="text-secondary" role="status" aria-live="polite">
                Showing @FirstVisible–@LastVisible of
                @filteredSensors.Length matching sensors.
            </p>

            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <caption>Registered devices and their telemetry settings.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Device</th>
                            <th scope="col">Location</th>
                            <th scope="col">Category</th>
                            <th scope="col">Data type</th>
                            <th scope="col">Registered (UTC)</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sensor in VisibleSensors)
                        {
                            <tr @key="sensor.Id">
                                <td>@sensor.DeviceIdentifier</td>
                                <td>@sensor.DeploymentLocation</td>
                                <td>@CategoryLabel(sensor.Category)</td>
                                <td>@sensor.DataType</td>
                                <td>@sensor.RegisteredAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="@($"sensors/{sensor.Id}/telemetry")">
                                            View telemetry
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="@($"sensors/{sensor.Id}/attachments")">
                                            Attachments
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3"
                 aria-label="Sensor list pages">
                <span>Page @currentPage of @PageCount</span>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@(currentPage == 1)"
                            @onclick="PreviousPage">
                        Previous
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@(currentPage == PageCount)"
                            @onclick="NextPage">
                        Next
                    </button>
                </div>
            </nav>
        }
    </div>
</section>

@code {
    [Parameter]
    public SensorProfile[] Sensors { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? LoadError { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private const int PageSize = 25;

    private SensorProfile[] filteredSensors = [];
    private string searchText = string.Empty;
    private string selectedCategory = string.Empty;
    private int currentPage = 1;

    private int PageCount => Math.Max(
        1,
        (filteredSensors.Length + PageSize - 1) / PageSize);

    private int FirstVisible => (currentPage - 1) * PageSize + 1;

    private int LastVisible => Math.Min(
        currentPage * PageSize,
        filteredSensors.Length);

    private IEnumerable<SensorProfile> VisibleSensors =>
        filteredSensors
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize);

    protected override void OnParametersSet()
    {
        ApplyFilters();
    }

    // goes back to page 1 because filtering may reduce no. of pages
    private void FilterChanged()
    {
        currentPage = 1;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var search = searchText.Trim();

        filteredSensors = Sensors
            .Where(sensor =>
                string.IsNullOrEmpty(selectedCategory) ||
                sensor.Category.ToString() == selectedCategory)
            .Where(sensor =>
                search.Length == 0 ||
                sensor.DeviceIdentifier.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                sensor.DeploymentLocation.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase))
            .OrderBy(
                sensor => sensor.DeviceIdentifier,
                StringComparer.OrdinalIgnoreCase)
            .ToArray();

        currentPage = Math.Clamp(currentPage, 1, PageCount);
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        selectedCategory = string.Empty;
        FilterChanged();
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < PageCount)
        {
            currentPage++;
        }
    }

    private async Task RefreshAsync()
    {
        await OnRefresh.InvokeAsync();
    }

    private static string CategoryLabel(SensorCategory category)
    {
        return category switch
        {
            SensorCategory.PowerConsumption => "Power consumption",
            _ => category.ToString()
        };
    }
}